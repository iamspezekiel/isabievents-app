# ============================================================================
# IsabiEvents — Environment Configuration
# Copy this file to `.env.local` and fill in the values you have.
# The app runs in DEMO MODE (mock data, simulated payments) when values are
# missing, so you only need the sections for the services you enable.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Firebase — Auth + Firestore (client, safe to expose)
#    Firebase Console → Project settings → General → Your apps → Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# 2. Firebase Admin SDK (server only — webhook fulfilment + seed script)
#    Option A: paste the whole service-account JSON as ONE line
#    Option B: on App Hosting / GCP leave both unset to use ADC
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# ---------------------------------------------------------------------------
# 3. Bachs payments — https://docs.bachs.io  (NGN + USD hosted checkout)
#    Dashboard → Developer Portal → API Keys
#    Sandbox keys (sk_sandbox_...) hit https://sandbox-api.bachs.io
#    Live keys    (sk_live_...)    hit https://api.bachs.io
# ---------------------------------------------------------------------------
BACHS_API_KEY=
# Endpoint SIGNING secret (Developer Portal → Webhooks → destination) — NOT a URL:
BACHS_WEBHOOK_SECRET=
# Public HTTPS origin for checkout redirects (Bachs rejects http://localhost):
APP_BASE_URL=

# ---------------------------------------------------------------------------
# 4. Cloudflare R2 — media storage (S3-compatible)
#    Cloudflare Dashboard → R2 → Manage R2 API Tokens
#    R2_PUBLIC_URL: custom domain (https://media.example.com) or
#                   bucket public URL (https://pub-xxxx.r2.dev)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# 5. WatchUp error tracking — https://watchup.site
#    Dashboard → Project → API Keys (headers: X-Watchup-Project / X-Watchup-Key)
#    Leave empty to disable (app makes no WatchUp network calls).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WATCHUP_PROJECT=
NEXT_PUBLIC_WATCHUP_KEY=
NEXT_PUBLIC_WATCHUP_BASE_URL=https://watchup.space

# ---------------------------------------------------------------------------
# 6. Email (SMTP) — transactional emails: welcome, payment confirmation,
#    contact form, newsletter. Leave empty → sends are skipped (logged only).
#    Gmail: host=smtp.gmail.com port=587, user=you@gmail.com, pass=app password
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where contact/subscribe/sale/new-user notifications are delivered:
ADMIN_EMAIL=admin@isabievents.ng

# ---------------------------------------------------------------------------
# 7. Genkit AI (optional) — Google Gemini key for AI flows
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
